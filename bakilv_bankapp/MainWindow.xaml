<!--A DESIGN AI ÁLTAL KÉSZÍTETT-->
    <Window x:Class="bakilv_bankapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bakilv_bankapp"
        mc:Ignorable="d"
        Title="Crack Bank - panel"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#08111F"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid Margin="0,0,0,-55">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07101D" Offset="0"/>
                <GradientStop Color="#0D1B30" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="45">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="145"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="CRACK BANK"
                           Foreground="#3F9CFF"
                           FontSize="14"
                           FontWeight="Bold"/>

                <TextBlock x:Name="udvlabel"
                           Text="Üdv!"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Bankszámla áttekintése"
                           Foreground="#71829A"
                           FontSize="12"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <Border Grid.Row="1"
                    Background="#126BC8"
                    CornerRadius="15"
                    Padding="24"
                    Margin="0,0,0,18">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.3"/>
                </Border.Effect>

                <Grid>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Jelenlegi egyenleg"
                                   Foreground="#C9E3FF"
                                   FontSize="12"/>

                        <Label x:Name="egyenleglabel"
                               Content="0 Ft"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Padding="0"
                               Margin="0,3,0,0"/>

                    </StackPanel>

                    <TextBlock Text="CRACK BANK"
                               Foreground="White"
                               Opacity="0.1"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#101B2B"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,18,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Legutóbbi tranzakciók"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <ListBox x:Name="tranzakciolog"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#D8E2F0"
                                 d:ItemsSource="{d:SampleData ItemCount=6}"/>

                    </Grid>

                </Border>

                <Border Grid.Column="1"
                        Background="#101B2B"
                        CornerRadius="14"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Pénzügyi művelet"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Összeg"
                                   Foreground="#8292A8"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>

                        <Border Background="#091321"
                                CornerRadius="8"
                                Height="42"
                                Margin="0,0,0,15">

                            <TextBox x:Name="osszeglabel"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="14"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"/>
                            

                        </Border>
                        <TextBlock Text="Számlaszám"
Foreground="#8292A8"
FontSize="12"
Margin="0,0,0,5"/>

                        <Border Background="#091321"
CornerRadius="8"
Height="42"
Margin="0,0,0,15">


                            <TextBox x:Name="szamlaszam"
         Background="Transparent"
         BorderThickness="0"
         Foreground="White"
         FontSize="14"
         Padding="12,0"
         VerticalContentAlignment="Center"/>
                        </Border>


                        <Button x:Name="feltoltes"
                                Content="＋  Pénz feltöltése"
                                Height="42"
                                Margin="0,0,0,10"
                                Background="#1677E8"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="penzfeltoltes">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                        <Button x:Name="levetel"
                                Content="−  Pénz levétel"
                                Height="42"
                                Background="#19283C"
                                Foreground="#D7E2F0"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="penzlevetel">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>
                        <Button x:Name="utalas"
Content="↗ Pénz utalása"
Height="42"
Margin="0,10,0,0"
Background="#126BC8"
Foreground="White"
BorderThickness="0"
FontSize="13"
FontWeight="SemiBold"
Cursor="Hand"
Click="penzutalas">


                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>


                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>

